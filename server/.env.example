# ==============================================================================
# Seollem AI Lounge - OCI (Oracle Cloud Infrastructure) Production Environment
# ==============================================================================

# Server Network Configuration
PORT=4000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:4000

# Security Secrets (Must change in production)
JWT_SECRET=seollem_oci_super_secret_jwt_key_2026_change_me!

# AI LLM Provider Configuration (Server-Side Only - NEVER exposed to frontend)
# Gemini API Key (Recommended for fast Korean conversational response)
GEMINI_API_KEY=
# Optional OpenAI API Key (Fallback or alternative model)
OPENAI_API_KEY=
DEFAULT_LLM_PROVIDER=gemini

# Economy / Heart Settings
HEARTS_PER_MESSAGE=3.7
DEFAULT_GUEST_HEARTS=50
PHONE_AUTH_BONUS_HEARTS=100

# Oracle Cloud Infrastructure (OCI) Specific Config
OCI_REGION=ap-chuncheon-1
OCI_TENANCY_OCID=
OCI_USER_OCID=
OCI_COMPARTMENT_OCID=

# Database / Storage (SQLite by default, easily swapped with OCI MySQL / PostgreSQL)
DATABASE_FILE=./data/seollem.json

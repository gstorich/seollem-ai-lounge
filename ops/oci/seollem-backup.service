[Unit]
Description=Back up SalonChat accounts and conversations
[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/seollem-ai-lounge/current/ops/oci/backup.py
UMask=0077
Nice=15
IOSchedulingClass=idle
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups /var/lib/seollem-ai-lounge
PrivateTmp=true
NoNewPrivileges=true
